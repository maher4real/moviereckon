# ============================================
# MovieReckon Environment Variables Template
# ============================================
# Copy this to .env and fill in your values
# ============================================

# ===========================================
# FRONTEND (Next.js) - Can be empty for same-origin deployments
# ===========================================

# MongoDB API URL (leave empty for Vercel same-origin deployments)
# Only set this if developing locally against a deployed Vercel backend
NEXT_PUBLIC_MONGODB_API_URL=""
# Legacy fallback (for older Vite builds)
# VITE_MONGODB_API_URL=""

# ===========================================
# BACKEND (Vercel Serverless) - Set these in Vercel Dashboard
# ===========================================

# MongoDB connection string (REQUIRED)
# Format: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/"

# MongoDB database name
MONGODB_DB_NAME="moviereckon"

# Optional: disable automatic index bootstrap on startup.
# Keep this false in production unless you manage indexes externally.
# MONGODB_SKIP_INDEX_BOOTSTRAP=false

# JWT secret for auth tokens (REQUIRED - generate a secure random string, min 32 chars)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"

# Better Auth configuration (used if you route auth requests through /api/better-auth/*)
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Required in production unless APP_URL is the canonical HTTPS application origin.
# Internal auth forwarding never derives this destination from request headers.
# BETTER_AUTH_URL="http://localhost:3000"
# Optional trusted origins for Better Auth callbacks and OAuth redirects (comma-separated)
# BETTER_AUTH_TRUSTED_ORIGINS="https://moviereckon.vercel.app,https://admin.moviereckon.com"
# Set to true to require email verification for email/password sign-in.
# BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION="false"

# Google OAuth credentials (REQUIRED for "Continue with Google")
# Create a Web application client in Google Cloud Console -> Google Auth Platform -> Clients.
# Add this exact Authorized redirect URI for the default server-side flow:
#   https://<your-domain>/api/auth/google-callback
# If Better Auth social login is used separately, also add:
#   https://<your-domain>/api/better-auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional explicit callback URL (recommended if behind custom proxy/domain)
# If empty, backend derives it from request host.
# GOOGLE_OAUTH_REDIRECT_URI="https://moviereckon.vercel.app/api/auth/google-callback"

# Optional Google Identity Services button and One Tap prompt. The default redirect
# flow above is more portable and remains enabled when this is false. Only turn this
# on after adding every exact site origin (scheme + host, no path) to the same OAuth
# client's Authorized JavaScript origins, for example:
#   https://moviereckon.vercel.app
#   http://localhost:3000
# GOOGLE_ONE_TAP_ENABLED="false"

# Cloudflare Turnstile CAPTCHA (REQUIRED for login and signup)
# Create in Cloudflare Dashboard -> Turnstile
# Test keys: site="1x00000000000000000000AA", secret="1x0000000000000000000000000000000AA"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Optional explicit hostname allow-list for CAPTCHA verification (comma-separated).
# If unset, backend allows current request host and VERCEL_URL.
# TURNSTILE_ALLOWED_HOSTNAMES="moviereckon.vercel.app,localhost"
# Optional verification timeout in milliseconds for Turnstile siteverify.
# TURNSTILE_VERIFY_TIMEOUT_MS=8000
# Optional maximum accepted challenge age in seconds.
# Keep at or below Cloudflare's token lifetime unless you have a specific reason.
# TURNSTILE_MAX_TOKEN_AGE_SECONDS=300
# Debug only: skip CAPTCHA hostname validation.
# TURNSTILE_SKIP_HOSTNAME_CHECK=false

# App URL used to build email verification and password reset links.
# Set this explicitly in Vercel for production.
APP_URL="http://localhost:3000"

# Nodemailer / SMTP email delivery for verification + password reset.
# MailerSend SMTP:
# - SMTP_FROM_EMAIL must be an address on your verified MailerSend domain/subdomain
# - SMTP_USER is the SMTP credential username, not the sender email
# - Never commit real SMTP credentials to this file
# SMTP_HOST="smtp.mailersend.net"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-mailersend-smtp-user"
# SMTP_PASS="your-mailersend-smtp-password"
# SMTP_FROM_EMAIL="noreply@your-verified-mailersend-domain"

# Server
# smtp.mailersend.net
# Port
# Connection security: TLS
# 587 or 2525
# Username
# your-mailersend-smtp-user
# Password
# Reset credentials
# your-mailersend-smtp-password

# Optional display name for outgoing email
# SMTP_FROM_NAME="MovieReckon"
# Optional reply-to override
# SMTP_REPLY_TO_EMAIL=""

# Optional pepper for verification/reset token hashing.
# If omitted, JWT_SECRET is used.
# EMAIL_TOKEN_PEPPER="replace-with-a-random-32-plus-char-secret"

# Email verification auth policy override:
# - true: bypass verification checks
# - false: enforce verification checks
# - unset: bypass verification (default)
# EMAIL_VERIFICATION_DISABLED="false"

# CORS origin allowlist (optional, comma-separated)
# Production example: CORS_ORIGIN="https://moviereckon.vercel.app"
# Local development example: CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
# If unset, secure defaults are used.
# CORS_ORIGIN="https://yourdomain.com"

# Optional pepper used when hashing refresh tokens before DB storage.
# Recommended: random 32+ char string.
# REFRESH_TOKEN_PEPPER="change-me-to-a-random-secret"
# Comma-separated bootstrap admin emails for RBAC role assignment.
# ADMIN_EMAILS="admin@yourdomain.com"
# Force role checks against DB role on privileged actions.
# RBAC_ENFORCE_DB=true
# Max active refresh-token sessions per user before older sessions are pruned.
# REFRESH_TOKEN_MAX_SESSIONS=8
# Enforce refresh token session fingerprint checks (recommended in production).
# SESSION_BINDING_STRICT=true

# Cookie security flags (optional)
# NOTE: production always forces Secure cookies even if this is set to false.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax

# In-memory hard limits for serverless abuse controls (optional).
# RATE_LIMIT_MAX_BUCKETS=60000
# RECOMMENDATIONS_CACHE_MAX_ENTRIES=2500

# Centralized abuse telemetry controls.
SECURITY_TELEMETRY_ENABLED=true
# SECURITY_TELEMETRY_CAPTURE_RAW=false
# SECURITY_EVENTS_TTL_SECONDS=1209600

# TMDB API key used by server-side /api/tmdb proxy (REQUIRED for movie/TV data)
# TMDB_API_KEY="your_tmdb_api_key_here"

# OpenAI API key — enables AI-powered recommendation ranking and explanations
# Get yours at https://platform.openai.com/api-keys
# Uses: text-embedding-3-small (candidate ranking) + gpt-4o-mini (explanations)
# Cost: ~$0.003 per user request
# OPENAI_API_KEY="sk-..."
