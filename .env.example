# MovieReckon Environment Variables
# Copy this file to .env.local for local development
# For Vercel deployment, set these in the Vercel dashboard

# ============================================
# Frontend Configuration
# ============================================
# Your deployed API URL (e.g., https://your-app.vercel.app)
# Set this to your Vercel app URL when deployed
VITE_MONGODB_API_URL=https://your-app.vercel.app

# ============================================
# MongoDB Configuration
# ============================================
# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# MongoDB database name (default: moviereckon)
MONGODB_DB_NAME=moviereckon

# ============================================
# JWT Configuration
# ============================================
# Secret key for signing JWT tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a strong, random value in production
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
