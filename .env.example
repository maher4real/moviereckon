# ============================================
# MovieReckon Environment Variables Template
# ============================================
# Copy this to .env and fill in your values
# ============================================

# ===========================================
# FRONTEND (Vite) - Can be empty for same-origin Vercel deployments
# ===========================================

# MongoDB API URL (leave empty for Vercel same-origin deployments)
# Only set this if developing locally against a deployed Vercel backend
VITE_MONGODB_API_URL=""

# ===========================================
# BACKEND (Vercel Serverless) - Set these in Vercel Dashboard
# ===========================================

# MongoDB connection string (REQUIRED)
# Format: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/"

# MongoDB database name
MONGODB_DB_NAME="moviereckon"

# JWT secret for auth tokens (REQUIRED - generate a secure random string, min 32 chars)
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars"

# TMDB credentials (REQUIRED - server-side only, never expose in frontend)
# Set one of these:
TMDB_API_KEY="your-tmdb-api-key"
# OR:
# TMDB_BEARER_TOKEN="your-tmdb-v4-read-token"
#
# Backward-compatible aliases also supported by backend:
# TMDB_KEY, TMDB_V3_API_KEY, TMDB_API_V3_KEY
# TMDB_READ_ACCESS_TOKEN, TMDB_ACCESS_TOKEN, TMDB_V4_TOKEN, TMDB_API_READ_ACCESS_TOKEN
#
# Optional legacy fallback (if you still have an existing Supabase tmdb-proxy deployed):
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
# SUPABASE_TMDB_FUNCTION="tmdb-proxy"

# CORS origin (optional - defaults to *)
# Set to your frontend domain in production for security
# CORS_ORIGIN="https://yourdomain.com"
