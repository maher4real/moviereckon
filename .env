# MovieReckon Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# MongoDB Backend (Optional - for Vercel deployment)
# ============================================
# When set, the app will use your MongoDB backend instead of Lovable Cloud
# Leave empty to use Lovable Cloud (Supabase) as the backend

# Your deployed Vercel app URL (e.g., https://your-app.vercel.app)
VITE_MONGODB_API_URL=

# ============================================
# Vercel Environment Variables (set in Vercel dashboard)
# ============================================
# These are NOT used by the frontend, but need to be set in Vercel

# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# MongoDB database name (default: moviereckon)
MONGODB_DB_NAME=moviereckon

# JWT secret for auth tokens (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
