{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "fluid": true,
  "outputDirectory": ".next",
  "functions": {
    "src/pages/api/health.ts": { "maxDuration": 30 },
    "src/pages/api/tmdb.ts": { "maxDuration": 30 },
    "src/pages/api/tmdb-image.ts": { "maxDuration": 30 },
    "src/pages/api/auth/**/*.ts": { "maxDuration": 60 },
    "src/pages/api/better-auth/**/*.ts": { "maxDuration": 60 },
    "src/pages/api/admin/**/*.ts": { "maxDuration": 30 },
    "src/pages/api/user/**/*.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/import/watch-sources", "schedule": "0 0 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" }
      ]
    },
    {
      "source": "/fallbacks/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/(app-icon.svg|icon-192.png|icon-512.png|apple-touch-icon.png|favicon.ico|placeholder.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
