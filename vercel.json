{
  "functions": {
    "api/auth.ts": {
      "runtime": "nodejs20.x"
    },
    "api/user.ts": {
      "runtime": "nodejs20.x"
    },
    "api/health.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/api/user/:path*", "destination": "/api/user" },
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
